# .env 템플릿. 복사해서 .env 로 쓰고 실제 비밀번호를 채운다.
#   cp .env.example .env
# MQTT 실시간 Command 발송. 기본 False(opt-in) — 쓰려면 True 로 명시한다.
# False 이면 paho import/접속/스레드/발행을 일절 하지 않고 REST 폴링만 동작한다.
MQTT_ENABLED=False
# MQTT_BROKER_HOST/PORT 는 보통 지정하지 않는다.
#   컨테이너: docker-compose.yml 기본값 172.26.0.1 (브로커가 별도 네트워크라 게이트웨이 경유)
#   호스트 도구: config.py 기본값 localhost
# 여기에 localhost 를 쓰면 compose 치환으로 컨테이너에도 localhost 가 주입되어 접속 실패한다.
#MQTT_BROKER_HOST=
#MQTT_BROKER_PORT=1883
# 컨트롤러 계정. ACL 은 'topic write cmd/#' (발행 전용)
MQTT_USERNAME=central
MQTT_PASSWORD=
# client_id = controller-{hostname}-{pid} 로 조립됨. 보통 바꿀 필요 없다
MQTT_CLIENT_ID_PREFIX=controller
# 재접속 재시도 주기(초, 고정) / 연결성 로그 억제 창(초)
MQTT_RECONNECT_DELAY=60
MQTT_LOG_THROTTLE_SECONDS=3600
